# NewsRadar environment configuration.
# Copy to .env and fill in secrets. Never commit .env.

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://newsradar:newsradar@localhost:5433/newsradar
REDIS_URL=redis://localhost:6380/0

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Connectors / data providers ---
PERIGON_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
YOUTUBE_API_KEY=

# --- Email delivery (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Alerting ---
SLACK_WEBHOOK_URL=

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# --- Observability ---
LOG_LEVEL=INFO
