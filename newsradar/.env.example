# NewsRadar environment configuration.
# Copy to .env and fill in secrets. Never commit .env.

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://newsradar:newsradar@localhost:5433/newsradar
REDIS_URL=redis://localhost:6380/0

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Connectors / data providers ---
PERIGON_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Telethon string session (read-only). Generate once locally; never commit a real value.
TELEGRAM_SESSION=
YOUTUBE_API_KEY=
# Stop YouTube ingestion once the estimated daily quota usage exceeds this (units).
YOUTUBE_DAILY_QUOTA_BUDGET=8000
# Descriptive User-Agent (with a contact URL) sent by every HTTP connector.
CONNECTOR_USER_AGENT=NewsRadarBot/1.0 (+https://newsradar.example/bot; contact=abuse@newsradar.example)
# Optional overrides for connector config files (default to <repo>/config/*.yaml).
FEEDS_PATH=
TELEGRAM_CHANNELS_PATH=
# Set false to disable the paid Perigon connector even when PERIGON_API_KEY is present.
PERIGON_ENABLED=true

# --- Email delivery (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Alerting ---
SLACK_WEBHOOK_URL=

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# --- Observability ---
LOG_LEVEL=INFO
