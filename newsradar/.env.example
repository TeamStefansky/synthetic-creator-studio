# NewsRadar environment configuration.
# Copy to .env and fill in secrets. Never commit .env.

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://newsradar:newsradar@localhost:5433/newsradar
REDIS_URL=redis://localhost:6380/0

# --- LLM ---
ANTHROPIC_API_KEY=
# Cheap per-document classifier and frontier summarizer (cost discipline: Haiku
# for the bulk, Sonnet only on event representatives).
HAIKU_MODEL=claude-haiku-4-5-20251001
SONNET_MODEL=claude-sonnet-5
# Max concurrent LLM calls and the hard daily spend guard (USD). When exceeded,
# enrichment degrades to embeddings + heuristics only.
LLM_MAX_CONCURRENCY=8
LLM_DAILY_BUDGET_USD=25.0

# --- Connectors / data providers ---
PERIGON_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Telethon string session (read-only). Generate once locally; never commit a real value.
TELEGRAM_SESSION=
YOUTUBE_API_KEY=
# Stop YouTube ingestion once the estimated daily quota usage exceeds this (units).
YOUTUBE_DAILY_QUOTA_BUDGET=8000
# Descriptive User-Agent (with a contact URL) sent by every HTTP connector.
CONNECTOR_USER_AGENT=NewsRadarBot/1.0 (+https://newsradar.example/bot; contact=abuse@newsradar.example)
# Optional overrides for connector config files (default to <repo>/config/*.yaml).
FEEDS_PATH=
TELEGRAM_CHANNELS_PATH=
# Set false to disable the paid Perigon connector even when PERIGON_API_KEY is present.
PERIGON_ENABLED=true

# --- Email delivery (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Alerting ---
SLACK_WEBHOOK_URL=

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_BATCH_SIZE=32

# --- Clustering (tunable without a code change) ---
CLUSTER_SIM_THRESHOLD=0.82
CLUSTER_DECAY_HALFLIFE_HOURS=48.0
CLUSTER_CANDIDATE_WINDOW_HOURS=72
CLUSTER_ASSIGN_MAX_GAP_HOURS=48

# --- Geo resolution ---
# Path to the GeoNames cities extract; defaults to the bundled data/ file.
# Populate the full dataset with scripts/download_geonames.py in production.
GEONAMES_PATH=

# --- Observability ---
LOG_LEVEL=INFO
