<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <title>{{ title }}</title>
  <style>
    @page { size: A4; margin: 2cm; }
    body {
      direction: rtl;
      text-align: right;
      font-family: "Noto Sans Hebrew", "Arial", "Helvetica", sans-serif;
      line-height: 1.6;
      color: #1a1a1a;
      font-size: 12pt;
    }
    h1 { font-size: 20pt; border-bottom: 2px solid #b22222; padding-bottom: 6px; }
    h2 { font-size: 15pt; color: #b22222; margin-top: 1.4em; }
    h3 { font-size: 12.5pt; color: #333; }
    a { color: #0645ad; text-decoration: none; word-break: break-all; }
    table { border-collapse: collapse; width: 100%; margin: 0.8em 0; }
    th, td { border: 1px solid #ccc; padding: 6px 8px; text-align: right; }
    th { background: #f3f3f3; }
    blockquote {
      border-right: 3px solid #b22222; margin: 0.6em 0; padding: 0.2em 0.9em;
      color: #444; background: #fafafa;
    }
    code { background: #f3f3f3; padding: 1px 4px; border-radius: 3px; }
    ul, ol { padding-right: 1.4em; }
    .meta { color: #777; font-size: 10pt; margin-bottom: 1.2em; }
    .footer { margin-top: 2em; border-top: 1px solid #ddd; padding-top: 6px;
              color: #999; font-size: 9pt; }
  </style>
</head>
<body>
  <div class="meta">
    NewsRadar · {{ watchlist_name }} · {{ period_start }} – {{ period_end }}
  </div>
  {{ body_html | safe }}
  <div class="footer">
    NewsRadar · הופק אוטומטית · {{ generated_at }} · מודל {{ model }}
  </div>
</body>
</html>
