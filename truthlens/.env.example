# ============================================================================
# TruthLens environment variables
# Copy this file to `.env.local` and fill in what you have.
# ALL core infrastructure features work WITHOUT any keys (free public APIs).
# Keys only unlock optional / higher-quality layers.
# ============================================================================

# Optional: lock the whole site behind a shared password (HTTP Basic Auth).
# When set, visitors must enter any username + this password. Leave empty to
# keep the site open. Never commit a real value - set it in the host's env vars.
SITE_PASSWORD=

# Required ONLY for the content-credibility layer (Anthropic / Claude).
# Without it, the content-analysis card is skipped and confidence is lower - # everything else (DNS/WHOIS/IP/SSL/archive/graph/scoring) still works.
ANTHROPIC_API_KEY=

# Optional: Google Fact Check Tools API key. Improves the reputation layer.
GOOGLE_FACTCHECK_KEY=

# Optional: ipinfo.io token. Raises IP/ASN/geo rate limits and accuracy.
# Without it the app falls back to ip-api.com (free, throttled).
IPINFO_TOKEN=

# Optional: Open PageRank API key (free at https://www.domcop.com/openpagerank/).
# Adds a 0-10 domain-authority signal to the legitimacy layer. Without it,
# authority is still estimated from domain age + Wayback longevity.
OPENPAGERANK_KEY=

# Optional: web search key for the content-propagation tracer (open-web only).
# Without it, propagation tracing relies on Wayback + is marked limited.
SEARCH_API_KEY=

# Optional (PAID): reverse-image search (TinEye / Google Vision). Disabled if empty.
IMAGE_SEARCH_KEY=

# The Origin Exposure audit (/tools/origin) works out of the box via FREE,
# keyless passive OSINT: AlienVault OTX (historical passive DNS) + HackerTarget
# (host search). These optional keys only raise rate limits / add a second
# historical source; NONE of the audit is gated behind them.
OTX_API_KEY=
HACKERTARGET_API_KEY=
SECURITYTRAILS_API_KEY=

# Reddit official API (OAuth app-only) for RELIABLE server-side monitoring — the
# keyless public JSON works but Reddit throttles server IPs. Create a "script" app
# at https://www.reddit.com/prefs/apps → use its client id + secret. Monitor a
# community with a watch term like "r/geopolitics" (bare = its new feed) or
# "r/geopolitics sanctions" (search within it). Without these, Reddit still runs
# keyless (may rate-limit). Official endpoint only; no scraping.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Webz.io licensed news API — broad global + multilingual recall, feeds News Room,
# SIGNAL Grid, Brand Watch, CIB and Geopolitics. Official endpoint; without it the
# source shows "not connected". Set the token here (never in code):
WEBZ_API_TOKEN=

# ---- Link Board evidence corroboration (reverse-lookup prevalence) -----------
# How many sites worldwide carry a shared tracker id? Without any of these, the
# Link Board shows "reverse-lookup not connected" and never assumes a shared id
# is unique. Official provider APIs only (no scraping). Any one is enough; they are
# tried in order SpyOnWeb → PublicWWW → DNSlytics.
SPYONWEB_API_KEY=
PUBLICWWW_API_KEY=
DNSLYTICS_API_KEY=

# ---- Social & Media Intelligence (Cyabra-style; all optional/paid) ----------
# X (Twitter) API v2 Bearer token - amplification + bot analysis on the report.
X_BEARER_TOKEN=

# AI-generated / deepfake IMAGE detection. Primary: Sightengine (both needed).
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Fallback image provider: Hive.
HIVE_API_KEY=

# ---- Monitoring & alerts (Vercel Cron hits /api/monitor daily) --------------
# Comma-separated domains to watch, e.g. "example.com,foo.co.il"
MONITOR_DOMAINS=
# Slack-compatible incoming webhook; receives an alert when a watched site is HIGH RISK.
ALERT_WEBHOOK_URL=
# If set, /api/monitor requires "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it).
CRON_SECRET=

# History store for change/spike detection in monitoring. Use EITHER Vercel KV
# (add the KV integration → it injects KV_REST_API_URL/TOKEN) OR Upstash Redis.
# Without it, monitoring falls back to current-state HIGH-RISK alerts only.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Narrative Intelligence platform (Stage 6 dashboard at /platform) --------
# URL of the deployed narrative-intel FastAPI service (no trailing slash).
# When unset, the /platform dashboard shows a "connect the platform" state.
NARRATIVE_API_URL=
# Optional API key if the platform is protected (matches its API_KEYS).
NARRATIVE_API_KEY=

# ---- Brand Watch (in-app narrative monitoring at /platform) ------------------
# Free keyless sources (GDELT, Bluesky, Hacker News, Reddit) need no config.
# Optional news sources - each shows "source not connected" until its key is set:
GUARDIAN_API_KEY=
NYT_API_KEY=
GNEWS_API_KEY=
# (NEWSAPI_KEY / RSS_FEEDS above are reused by Brand Watch too.)
# Continuous monitoring (watchlist + scheduled scans) needs the KV store above.
# Escalation alerts are delivered to Telegram and/or the webhook:
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- Account-authenticity platform provider (Phase 2) ---
# Unset → authenticity runs on mention-derived signals only (lower confidence).
# "official" → official APIs: Bluesky public AppView (keyless) + X (needs
#              X_BEARER_TOKEN) + Instagram (needs the Meta Graph vars below).
#              No scraping, no third-party wrappers.
# "stub"     → deterministic fixtures (tests/dev only).
PLATFORM_PROVIDER=

# --- Facebook Login (Meta OAuth) - the "Continue with Facebook" path -----------
# Standard Meta OAuth for the Meta Assets monitoring view (/tools/meta). Requests
# EXACTLY: public_profile, pages_show_list, pages_read_engagement, instagram_basic.
# Read/monitor only - no publish/ads/messaging permission is ever requested.
# App ID + secret come from the Meta App Dashboard (App settings → Basic).
# NEVER commit real values - set them in the host's env vars.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional. When unset, the redirect URI is derived from the request origin
# (https://<host>/api/auth/facebook/callback), so production and localhost both
# work. Whatever is used must be whitelisted in the Meta App Dashboard under
# Facebook Login → Settings → Valid OAuth Redirect URIs:
#   https://synthetic-creator-studio.vercel.app/api/auth/facebook/callback
#   http://localhost:3000/api/auth/facebook/callback
FACEBOOK_REDIRECT_URI=

# --- Instagram via Meta Graph "Business Discovery" (official, public-data-only) ---
# Lets an operator's OWN Instagram Business/Creator account (linked to a Facebook
# Page) look up PUBLIC profile + recent-media metrics of OTHER Business/Creator
# accounts by username. Both required; unset → Instagram renders "source not
# connected" (never faked). Personal/private accounts are NOT covered by the API.
# Note: the Graph API does not expose account creation date → the account-age
# signal stays "Not collected" for Instagram.
META_GRAPH_TOKEN=
IG_USER_ID=
# Optional Graph API version override (default v22.0).
META_GRAPH_VERSION=

# --- SIGNAL console: catalog sources (all official endpoints; unset → the
#     source renders "not connected", never faked) ---
# YouTube Data API v3 (free quota) - video mentions + channel names.
YOUTUBE_API_KEY=
# NewsData.io (free tier) - global news breadth with source country.
NEWSDATA_API_KEY=
# Mediastack (free tier) - additional global news wire.
MEDIASTACK_API_KEY=
# Keyless (no vars needed, on by default): GDELT DOC 2.0 + GDELT tone,
# Wikipedia Pageviews (attention trend), Bluesky, Hacker News, Reddit.

# --- Geopolitics situational layer (/tools/geopolitics) ---
# Keyless & on by default: UCDP, ReliefWeb, USGS, NASA EONET, Polymarket, Metaculus.
# ACLED (political-violence events) needs a free myACLED registration:
ACLED_KEY=
ACLED_EMAIL=

# --- Nonprofit / NGO registries (/tools/ngo) ---
# Keyless & on by default: ProPublica Nonprofit Explorer (US IRS Form 990).
# UK Charity Commission needs a free API subscription key:
CHARITY_COMMISSION_KEY=

# --- Programmatic API (/api/v1) ---
# Comma-separated API keys (each >= 8 chars). Unset = API disabled (honest 503).
TRUTHLENS_API_KEYS=
# Requests per key per minute (best-effort, needs a KV store). Default 60.
TRUTHLENS_API_RATE_LIMIT=60

# --- OSINT pivot adapters (reverse-lookup / enumeration; official APIs only) ---
# Reverse AdSense/analytics/shared-code (cheapest, highest ROI):
SPYONWEB_API_KEY=
PUBLICWWW_API_KEY=
DNSLYTICS_API_KEY=
# CT-logs + live subdomains + screenshots (crt.sh is keyless & always on):
URLSCAN_API_KEY=
# Passive-DNS / subdomains / WHOIS history:
SECURITYTRAILS_API_KEY=
# (enterprise, optional) reverse-IP / IOC context:
DOMAINTOOLS_API_KEY=
RECORDEDFUTURE_API_KEY=
REVERSETRACKER_API_KEY=
